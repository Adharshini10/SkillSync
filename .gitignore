# ============================================================
# Root .gitignore for SkillSync (Spring Boot + React/Vite)
# ============================================================

# Frontend dependencies and build artifacts
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
node_modules/
dist/
dist-ssr/

# Backend Maven build outputs
backend/target/
target/
!.mvn/wrapper/maven-wrapper.jar
*.jar
*.war

# Environment variables & secrets
.env
.env.local
.env.*.local
*.env
application-secret.properties

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE and Editor files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
*.sublime-project
*.sublime-workspace

# OS metadata
.DS_Store
Thumbs.db
